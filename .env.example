# Copy this file to .env and adjust values before running
# `docker compose up`. docker-compose.yml reads these variables to
# configure the PostgreSQL and Django services.

# --- PostgreSQL --------------------------------------------------------
POSTGRES_DB=storemesh
POSTGRES_USER=storemesh
POSTGRES_PASSWORD=change-me-please
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django --------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
